# NEX MARKET — Environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=NEX MARKET
NEXT_PUBLIC_DEFAULT_REGION=Toshkent

# --- Payme (optional, leave empty to keep online payments "unconfigured") ---
# Docs: https://developer.payme.uz
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_CALLBACK_URL=

# --- Click (optional) ---
# Docs: https://docs.click.uz
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_CALLBACK_URL=

# --- Delivery ---
DELIVERY_FEE_UZS=25000
FREE_DELIVERY_THRESHOLD_UZS=500000
