# PostgreSQL; use a dedicated database with TLS on production.
DATABASE_URL=postgresql://user:password@localhost:5432/nex_market
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=NEX MARKET
NEXT_PUBLIC_DEFAULT_REGION=Toshkent
# SMTP is required for registration, email verification, password recovery and optional email two-factor authentication.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Online payments are disabled pending complete provider integrations.
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Twilio Verify SMS adapter for one-time phone registration verification.
# Do not put these secrets in source control or chat.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
